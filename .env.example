# ---- Scraper (playwright) — reference_materials/scrape.js ----
# Repo root .env is loaded by npm run scrape. GitHub OAuth only.
GITHUB_EMAIL=your@email.com
GITHUB_PASSWORD=your_password

# Optional: run with visible browser
# HEADLESS=false

# ---- Future local ADE client ----
# Primary: local API. All API calls use this base; default to local backend.
# API_BASE_URL=http://localhost:8283
# Optional (e.g. dev): API_BASE_URL=https://api.letta.com
